# Sample MEDIATA Node Configuration
PORT=8080
FDP_PORT=18080
FDP_MONGO_PORT=37017
NAME=MyNodeName
DESC=My MEDIATA node description
COLOR=#008000
NODE_IP=https://mynode.mediata.dev

# Sample security params. Change in production.
SPRING_SECURITY_USER_NAME=cf9e0aac7c1054a748b7d618a6a2b6af
JWT_SECRET=9k8w3r2x1p0mN6bV4cZ7aS5dF3gH2jK1lP0qW8eR6tY4uI2o
TRUSTED_PROXY_SHARED_SECRET=replace-with-the-same-secret-configured-in-orchestrator-trusted-servers-config

# Set to false to disable OpenAPI JSON/YAML and Swagger UI.
API_DOCS_ENABLED=true

# Set to false only on an isolated node with synthetic data.
DISCOVERY_HISTORY_ENABLED=true
# Production peer-key lookup uses HTTPS. Enable HTTP only in an isolated local stack.
SECURE_POOL_ALLOW_HTTP_REGISTRY=false
# Protected summaries are stored and reused for each dataset version.
# This allowance does not compose privacy loss across overlapping datasets or versions.
# Site-level summaries favor research utility; 80 is weak row privacy.
# Secure pooled inputs use their own lower allowance, independent of this setting.
DISCOVERY_APPROXIMATE_POOLING_MAX_DATASET_EPSILON=80
# Raising the allowance adds one cached release and accounts for prior releases.

# Set to true to record and synchronize harmonization provenance.
HARMONIZATION_PROVENANCE_ENABLED=false
